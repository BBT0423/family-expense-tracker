# EditorConfig for Vue.js/TypeScript project
# https://EditorConfig.org

root = true

# All files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# TypeScript and JavaScript files
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2
max_line_length = 120
quote_type = single

# Vue files
[*.vue]
indent_size = 2
max_line_length = 120

# JSON files
[*.json]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# HTML files
[*.html]
indent_size = 2

# CSS, SCSS, and Less files
[*.{css,scss,less,sass}]
indent_size = 2

# Configuration files
[{package.json,.prettierrc,.eslintrc,.babelrc}]
indent_size = 2

# Dockerfile
[Dockerfile]
indent_size = 4

# Shell scripts
[*.sh]
indent_size = 2
end_of_line = lf

# Batch files
[*.{cmd,bat}]
end_of_line = crlf
